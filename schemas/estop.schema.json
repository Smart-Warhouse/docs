{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-warehouse.local/schemas/estop.schema.json",
  "title": "Fleet E-stop (wh/fleet/estop, retained)",
  "type": "object",
  "properties": {
    "engaged": {
      "type": "boolean"
    },
    "by": {
      "type": [
        "string",
        "null"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "engaged",
    "seq",
    "ts"
  ],
  "additionalProperties": true
}
