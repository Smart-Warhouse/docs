{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-warehouse.local/schemas/task_status.schema.json",
  "title": "Task progress (wh/fl/{id}/task_status)",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "to_pickup",
        "picking",
        "to_drop",
        "dropping",
        "done",
        "failed"
      ]
    },
    "reason": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "task_id",
    "status",
    "seq",
    "ts"
  ],
  "additionalProperties": true
}
